# Umair Sadiq portfolio — static export served by Apache (Hostinger)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# One canonical host and no duplicate URLs: no www, no /index.html (Hostinger already forces https)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://umairsadiq.com/$1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
  # Next.js also exports its 404 page as folders; answer them with a real 404, not a 200 duplicate.
  RewriteRule ^(404|_not-found)(/.*)?$ - [R=404,L]
</IfModule>

# Long cache for fingerprinted build assets, short cache for pages
<IfModule mod_headers.c>
  # Build assets in /_next have content hashes in their names, so they can be cached forever.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images keep their names when replaced, so cache them for a week only.
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|gif|ico|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml application/manifest+json application/ld+json
</IfModule>

# Social preview image is exported without an extension — serve it as PNG
<Files "opengraph-image">
  ForceType image/png
</Files>
