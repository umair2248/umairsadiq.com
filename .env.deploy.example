# Copy this file to .env.deploy and fill it in.

# ── Option A (recommended): SSH with a key, no password needed ──
# SSH_HOST can be an alias from ~/.ssh/config.
DEPLOY_METHOD=ssh
SSH_HOST=palbreedhub
SSH_DIR=domains/umairsadiq.com/public_html

# ── Option B: FTP (used when DEPLOY_METHOD is not "ssh") ──
# Find these in Hostinger hPanel → Files → FTP Accounts.
# .env.deploy is ignored by git and is never uploaded with the site.

# e.g. ftp.umairsadiq.com, or the IP address shown in hPanel
FTP_HOST=
# e.g. u123456789.umairsadiq.com
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# Optional. Leave empty to detect public_html automatically.
FTP_DIR=
